<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file datatype="plaintext" original="Sources/Forms/HDI2/form.4DForm" source-language="en" target-language="ja">
    <body>
      <trans-unit id="HDI2_Text7" resname="HDI2_Text7">
        <source>In this part you will learn how to query the DataStore</source>
        <target>このパートでは、DataStoreへのクエリの方法を学びます</target>
      </trans-unit>
      <trans-unit id="HDI2_TextSalaryGreaterThan" resname="HDI2_TextSalaryGreaterThan">
        <source>View employees with a salary greater than:</source>
        <target>給与が次の額より多い従業員を表示:</target>
      </trans-unit>
      <trans-unit id="HDI2_TextFindAllSalaries" resname="HDI2_TextFindAllSalaries">
        <source>Find all the salaries:</source>
        <target>すべての給与を検索:</target>
      </trans-unit>
      <trans-unit id="HDI2_TextLastNameBeginsWith" resname="HDI2_TextLastNameBeginsWith">
        <source>View employees whose last name begins with:</source>
        <target>姓が次で始まる従業員を表示:</target>
      </trans-unit>
      <trans-unit id="HDI2_TextListOfEmployees" resname="HDI2_TextListOfEmployees">
        <source>List of employees</source>
        <target>従業員一覧</target>
      </trans-unit>
      <trans-unit id="HDI2_TextOr" resname="HDI2_TextOr">
        <source>or</source>
        <target>または</target>
      </trans-unit>
      <trans-unit id="HDI2_TextSalaryBetween" resname="HDI2_TextSalaryBetween">
        <source>View employees whose salary is between:</source>
        <target>給与が次の範囲内の従業員を表示:</target>
      </trans-unit>
      <trans-unit id="HDI2_TextAnd" resname="HDI2_TextAnd">
        <source>and</source>
        <target>から</target>
      </trans-unit>
      <trans-unit id="HDI2_TextWildcardEqual" resname="HDI2_TextWildcardEqual">
        <source>Search a string with the '@' wildcard character with the '=' operator:</source>
        <target>'=' 演算子で '@' ワイルドカード文字を使用した文字列を検索:</target>
      </trans-unit>
      <trans-unit id="HDI2_TextWildcardTripleEqual" resname="HDI2_TextWildcardTripleEqual">
        <source>Search a string with the '@' character in an email address with the '===' operator:</source>
        <target>'===' 演算子でメールアドレス内の '@' 文字を使用した文字列を検索:</target>
      </trans-unit>
      <trans-unit id="HDI2_BtnQuery" resname="HDI2_BtnQuery">
        <source>Query</source>
        <target>クエリ</target>
      </trans-unit>
      <trans-unit id="HDI2_BtnViewAll" resname="HDI2_BtnViewAll">
        <source>View all</source>
        <target>すべて表示</target>
      </trans-unit>
      <trans-unit id="HDI2_BtnReset" resname="HDI2_BtnReset">
        <source>Reset</source>
        <target>リセット</target>
      </trans-unit>
      <trans-unit id="HDI2_ColFirstName" resname="HDI2_ColFirstName">
        <source>firstName</source>
        <target>名</target>
      </trans-unit>
      <trans-unit id="HDI2_ColLastName" resname="HDI2_ColLastName">
        <source>lastName</source>
        <target>姓</target>
      </trans-unit>
      <trans-unit id="HDI2_ColSalary" resname="HDI2_ColSalary">
        <source>salary</source>
        <target>給与</target>
      </trans-unit>
      <trans-unit id="HDI2_ColEmployerName" resname="HDI2_ColEmployerName">
        <source>employer.name</source>
        <target>雇用主</target>
      </trans-unit>
      <trans-unit id="HDI2_ColEmail" resname="HDI2_ColEmail">
        <source>email</source>
        <target>メール</target>
      </trans-unit>
    </body>
